# =========================================
# AXORA Backend (Node.js/Express) - Environment Configuration
# Copy this file to .env and adjust if your setup differs from XAMPP defaults.
# =========================================

# ---- Database (MySQL via XAMPP) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=axora_db
DB_USER=root
DB_PASSWORD=

# ---- Server ----
PORT=8081

# ---- JWT ----
JWT_SECRET=AxoraSuperSecretKeyForJWTSigning_ChangeThisInProduction_2026
JWT_EXPIRES_IN=1d

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- File Upload ----
UPLOAD_DIR=uploads
